# ── Next.js app (Vercel) ──────────────────────────────────────────────────────
# Postgres (Vercel Postgres / Neon). Use the pooled connection string.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Magic-link / verification email (optional in dev — without it, links are
# printed to the server console instead of sent).
RESEND_API_KEY=
EMAIL_FROM=Transit DAW <onboarding@resend.dev>

# AI Composer — proxied same-origin via /api/compose (key stays server-side)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

# Lemon Squeezy subscriptions. Create one Pro product with monthly + annual
# variants, then point its signed webhook at /api/billing/webhook.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_ANNUAL=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Feedback / bug-report form (/feedback). Reports are stored in Postgres and
# emailed here; unset falls back to the contact address in lib/legal.js.
FEEDBACK_TO=

# Cloudflare Turnstile — bot protection on the feedback form. The site key is
# public (it ships to the browser); only the secret is sensitive. Unset secret
# means server-side verification is skipped, which is fine in dev.
# Cloudflare's always-pass test pair:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Always-fail secret (to exercise the error path): 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAElGB-3gZGRhYe9B
TURNSTILE_SECRET_KEY=

# Hostnames a Turnstile token may come from, comma separated. Optional: unset
# derives the allowlist from NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL plus
# localhost. Set it when the app is served from a hostname those don't name.
TURNSTILE_HOSTNAMES=

# Route data (~22 MB). Leave unset for local dev (falls back to public/data/lines.json).
# In production, upload with `npm run upload:lines` and set the printed Blob URL here.
NEXT_PUBLIC_LINES_URL=
# Only needed to run `npm run upload:lines` (Vercel → Storage → Blob store).
BLOB_READ_WRITE_TOKEN=

# Server-side: /api/snapshot proxies to the feed service at this URL
FEED_HTTP_URL=http://localhost:3005

# ── Feed service (separate always-on process) ─────────────────────────────────
BKK_API_KEY=
PORT=3005

# Client connects directly to the feed's WebSocket (can't proxy WS via serverless)
NEXT_PUBLIC_FEED_WS_URL=ws://localhost:3005
